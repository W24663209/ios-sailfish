--- /dev/null
+++ b/bsd/dev/msm8996_board.c
@@ -0,0 +1,56 @@
+/*
+ * Runtime board identity for the MSM8996 XNU port.
+ *
+ * The kernel still builds as MACHINE_CONFIG=SWEET because that controls the
+ * shared Kryo/GIC/UFS platform implementation.  Board peripherals must not
+ * inherit Sailfish register sequences merely because the SoC is shared.  The
+ * generated Marlin ADT adds ios-sailfish,msm8996-marlin to root compatible.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <pexpert/device_tree.h>
+
+static bool
+msm8996_compatible_has(const char *property, unsigned size, const char *want)
+{
+	unsigned at = 0;
+	while (at < size) {
+		unsigned n = 0;
+		while (at + n < size && property[at + n] != '\0') {
+			n++;
+		}
+		unsigned i = 0;
+		while (i < n && want[i] != '\0' && property[at + i] == want[i]) {
+			i++;
+		}
+		if (i == n && want[i] == '\0') {
+			return true;
+		}
+		at += n + 1;
+	}
+	return false;
+}
+
+bool
+msm8996_board_is_marlin(void)
+{
+	static int cached = -1;
+	DTEntry root;
+	void const *value = NULL;
+	unsigned size = 0;
+
+	if (cached >= 0) {
+		return cached != 0;
+	}
+	cached = 0;
+	if (SecureDTLookupEntry(NULL, "/", &root) == kSuccess &&
+	    SecureDTGetProperty(root, "compatible", &value, &size) == kSuccess &&
+	    value != NULL) {
+		cached = msm8996_compatible_has((const char *)value, size,
+		    "ios-sailfish,msm8996-marlin") ? 1 : 0;
+	}
+	printf("MSM8996 BOARD: %s\n", cached ? "marlin (peripherals deferred)" : "sailfish");
+	return cached != 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
